[Unit]
Description=VideoNews Studio opt-in SMTP disk pressure warnings
Documentation=https://github.com/whiteyOnTheMoon/videonews-studio/blob/main/docs/P1-09_EMAIL_ALERTS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ap
Group=ap
WorkingDirectory=/home/ap/www/videonews-studio
ExecStart=/usr/bin/python3 /home/ap/www/videonews-studio/scripts/p1_09_email_alert.py --send --path /home/ap/www/videonews-studio --state-dir /var/lib/vns-disk-email
StateDirectory=vns-disk-email
StateDirectoryMode=0700
StandardOutput=journal
StandardError=journal
SyslogIdentifier=videonews-disk-email
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
TasksMax=16
MemoryMax=96M
TimeoutStartSec=40s
