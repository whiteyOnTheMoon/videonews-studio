{
  "name": "@vns/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/*.test.js",
    "dispatch": "node dist/dispatch.js",
    "provider-outbox-once": "node dist/provider-outbox-once.js --once",
    "status-sync": "node dist/status-sync.js",
    "research-service": "node dist/research-service.js",
    "feed-observe-once": "node dist/feed-observe-once.js --once",
    "feed-scheduler-bounded": "node dist/feed-scheduler-bounded.js --bounded",
    "feed-source-publish-once": "node dist/feed-source-publish-once.js --once",
    "source-handoff-import-once": "node dist/source-handoff-import-once.js --once",
    "feed-producer-bounded": "node dist/feed-producer-bounded.js --bounded-producer",
    "feed-worker-persistent": "node dist/feed-worker-persistent.js --persistent-worker",
    "feed-consumer-healthcheck": "node dist/feed-consumer-healthcheck.js",
    "feed-producer-continuous": "node dist/feed-producer-continuous.js --continuous",
    "feed-producer-healthcheck": "node dist/feed-producer-healthcheck.js",
    "feed-queue-operations": "node dist/feed-queue-operations.js --inspect",
    "feed-project-once": "node dist/feed-candidate-project-once.js --once"
  },
  "dependencies": {
    "@vns/shared": "*",
    "bullmq": "6.4.0",
    "ioredis": "6.0.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "@types/pg": "8.15.5"
  }
}
